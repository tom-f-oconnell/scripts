 document.querySelectorAll('.turn').forEach(t=>{const h=q&&!t.innerText.toLowerCase().includes(q);t.classList.toggle('hidden',h);
  const a=document.querySelector('nav a[href="#'+t.id+'"]'); if(a) a.classList.toggle('hidden',h);});}
