th{color:var(--muted);font-weight:normal} td.n{text-align:right} a{color:var(--accent)} tr.hidden{display:none}
"""


def session_info(page: Path):
    """The metadata render() embeds in a session page (None for other HTML files)."""
    m = re.search(r'<meta name="claude-conversation" content="([^"]*)">', page.open(errors='replace').read(4000))
    try:
        return json.loads(html.unescape(m.group(1))) if m else None
    except ValueError:
        return None


def write_index():
    """Writes OUT_ROOT/index.html linking every session page under OUT_ROOT, grouped by project
    with the most recently active first. Returns (path, number of sessions, number of projects).
    """
    by_project = {}
    for page in OUT_ROOT.glob('*/*.html'):
        info = session_info(page)
        if info:
            info['href'] = str(page.relative_to(OUT_ROOT))
            by_project.setdefault(info['project'], []).append(info)
    parts = []
    for project, infos in sorted(by_project.items(), key=lambda kv: max(i['last'] for i in kv[1]), reverse=True):
        rows = ''.join(f'<tr data-s><td><a href="{html.escape(i["href"])}">{html.escape(i["name"])}</a></td>'
            f'<td class="n">{i["prompts"]}</td><td>{i["first"]}</td><td>{i["last"]}</td><td><small>{i["session"][:8]}</small></td></tr>'
            for i in sorted(infos, key=lambda i: i['last'], reverse=True))
        parts.append(f'<h2>{html.escape(project)}</h2><table><tr><th>session</th><th class="n">prompts</th>'
            f'<th>first prompt</th><th>last prompt</th><th>id</th></tr>{rows}</table>')
    n = sum(len(v) for v in by_project.values())
    js = ("function flt(){const q=document.getElementById('q').value.toLowerCase();document.querySelectorAll('tr[data-s]')"
        ".forEach(r=>r.classList.toggle('hidden',q&&!r.innerText.toLowerCase().includes(q)));}")
    out = OUT_ROOT / 'index.html'
    out.write_text(f'<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>Claude Code sessions</title>'
        f'<style>{INDEX_CSS}</style></head><body><h1>Claude Code sessions</h1><div class="meta">{plural(n, "rendered session")} in '
        f'{plural(len(by_project), "project")} · generated {dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")} · '
        f'run claude-conversation (--all) in a project to add or refresh its sessions</div>'
        f'<input id="q" placeholder="filter sessions" oninput="flt()">' + '\n'.join(parts) + f'<script>{js}</script></body></html>')
    return out, n, len(by_project)


def plural(n: int, word: str) -> str:
    return f'{n} {word}{"" if n == 1 else "s"}'


def find_sessions(project_dir: Path):
    return sorted(project_dir.glob('*.jsonl'), key=lambda p: p.stat().st_mtime, reverse=True)


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    ap.add_argument('--project', type=Path, default=Path.cwd(), help='project directory (default: cwd)')
    ap.add_argument('--session', help='session id (prefix) in that project')
    ap.add_argument('--jsonl', type=Path, help='explicit transcript file')
    ap.add_argument('--all', action='store_true', help='render every session of the project')
    ap.add_argument('--out', type=Path, help='output HTML path (single session)')
    ap.add_argument('--open', action='store_true', help='open the page in the browser (xdg-open)')
    ap.add_argument('--auto-refresh', type=int, default=0, metavar='SEC', help='page reloads itself every SEC seconds')
    ap.add_argument('--watch', type=int, default=0, metavar='SEC', help='regenerate every SEC seconds (implies --auto-refresh SEC)')
    ap.add_argument('-v', '--verbose', action='store_true',
        help='print each page path with its session name and prompt count, then the index URL '
        '(default: only one URL, of the page or, for several sessions, of the index)')
    args = ap.parse_args()
    slug = project_slug(args.project.resolve())
    pdir = PROJECTS / slug
    if args.jsonl:
        files = [args.jsonl]
    else:
        if not pdir.exists():
            sys.exit(f'no transcripts for {args.project} (expected {pdir})')
        files = find_sessions(pdir)
        if args.session:
            files = [f for f in files if f.stem.startswith(args.session)]
        if not args.all:
            files = files[:1]
        if not files:
            sys.exit('no matching session')
    refresh = args.watch or args.auto_refresh
    first_pass = True
    while True:
        outs = []
        for f in files:
            turns, name = build_turns(f)
            prompts = [t for t in turns if t['kind'] == 'prompt']
            if not name:   # untitled: fall back to the start of the first prompt
                first = prompts[0]['prompt'].split('\n')[0] if prompts else ''
                name = (first[:60] + '...') if len(first) > 60 else first or '(empty session)'
            out = args.out if (args.out and len(files) == 1) else OUT_ROOT / slug / f'{f.stem}.html'
            out.parent.mkdir(parents=True, exist_ok=True)
            out.write_text(render(turns, name, f, args.project.resolve(), refresh))
            outs.append(out)
            if args.verbose:
                print(f'{out}  "{name}"  ({plural(len(prompts), "prompt")})', flush=True)
        index, n_sessions, n_projects = write_index()
        if args.verbose:
            print(f'index of all rendered sessions: {index.as_uri()}  ({plural(n_sessions, "session")} in {plural(n_projects, "project")})', flush=True)
        elif first_pass:   # the URLs do not change between --watch passes
            print((outs[0].resolve() if len(outs) == 1 else index).as_uri(), flush=True)
        first_pass = False
        if args.open:
            for out in outs:
                subprocess.Popen(['xdg-open', str(out)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            args.open = False
        if not args.watch:
            break
        time.sleep(args.watch)


if __name__ == '__main__':
    main()
