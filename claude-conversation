def live_js() -> str:
    return LIVE_JS.replace('IDLE_MIN', str(IDLE_TIMEOUT // 60))


def stamp_meta() -> str:
    """Tags for the page's version and generation time (both filled in by write_page())."""
    return f'<meta name="{VERSION_TAG}" content="{VERSION_SLOT}"><meta name="{GENERATED_TAG}" content="{GENERATED_SLOT}">'


def page_stamp(path: Path) -> tuple:
    """(version, generation time) of the page at path, from its stamp_meta() ((None, None) if missing)."""
    try:
        with path.open(errors='replace') as f:
            head = f.read(2000)
    except OSError:
        return None, None
    tags = [re.search(f'<meta name="{t}" content="([^"]*)">', head) for t in (VERSION_TAG, GENERATED_TAG)]
    return tuple(m.group(1) if m else None for m in tags)


def write_atomic(path: Path, text: str) -> None:
    """Writes path through a temporary file, so open pages never load it half written."""
    tmp = path.with_name(f'.{path.name}.tmp')
    tmp.write_text(text)
    os.replace(tmp, path)


def stamp_page(page: str, generated: str | None = None) -> tuple:
    """(page with its version and generation time filled in, version, generation time). The version is a
    hash of its content apart from the title line, whose server description and generation time change
    without the content doing so; the generation time is now unless given.
    """
    version = hashlib.sha1(re.sub('<header>.*?</header>', '', page, count=1).encode()).hexdigest()[:16]
    generated = generated or f'{dt.datetime.now():%Y-%m-%d %H:%M:%S}'
    return page.replace(VERSION_SLOT, version).replace(GENERATED_SLOT, generated), version, generated


def write_page(path: Path, page: str) -> None:
    """Writes page (from render() or for the index) to path, stamped (stamp_page()), and its version and
    generation time to <path>.version.js, which pages opened as files load to check for new versions.
    """
    text, version, now = stamp_page(page)
    write_atomic(path, text)
    write_atomic(path.with_suffix('.version.js'), f'ccVersion({json.dumps(version)},{json.dumps(now)});\n')


SERVER_SLOT = '<span id="srv"></span>'   # filled in by the server (QuietHandler.fill_title()) when it sends the page


def header_html(index_href: str | None = None) -> str:
    """The title line at the top of every page: "claude conversations" (linking to index_href, if
    given), then, de-emphasized, the server's details (when served) and the generation time.
    """
    title = f'<a href="{html.escape(index_href)}">claude conversations</a>' if index_href else 'claude conversations'
    return (f'<header><b>{title}</b><span>{SERVER_SLOT}generated <time id="gen">{GENERATED_SLOT}</time></span></header>'
        '<div id="live" hidden></div>')


