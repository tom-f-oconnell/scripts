TAGS_NOT_PROMPT = ('<task-notification', '<system-reminder', '<local-command', '<command-name',
    '<bash-input', '<bash-stdout', '<bash-stderr', 'Another Claude session sent a message',
    '[Image:', 'Base directory for this skill', '<agent-message')


def project_slug(cwd: Path) -> str:
    return re.sub(r'[^A-Za-z0-9]', '-', str(cwd))


def load_entries(path: Path):
    for line in path.open(errors='replace'):
        try:
            yield json.loads(line)
        except json.JSONDecodeError:
            continue


def text_of(content) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return '\n'.join(b.get('text', '') for b in content if isinstance(b, dict)
            and b.get('type') == 'text')
    return ''


def classify_user(o) -> str:
    """'prompt' (typed by the user), 'summary' (context continuation), or 'other'."""
    c = o.get('message', {}).get('content')
    if isinstance(c, list) and any(isinstance(b, dict) and b.get('type') == 'tool_result' for b in c):
        return 'other'
    if o.get('isCompactSummary'):
        return 'summary'
    t = text_of(c).strip()
    if not t or o.get('isMeta') or any(t.startswith(x) for x in TAGS_NOT_PROMPT):
        return 'other'
    return 'prompt'


def local_time(ts: str) -> str:
    try:
        t = dt.datetime.fromisoformat(ts.replace('Z', '+00:00')).astimezone()
        return t.strftime('%Y-%m-%d %H:%M')
    except Exception:
        return ts or ''


def session_title(entries) -> str:
    """The session's name as `/resume` lists it: the title given with /rename if any, else the
    latest AI-generated title (absent from sessions that never completed a turn)."""
    custom = ai = ''
    for o in entries:
        if o.get('type') == 'custom-title':
            custom = o.get('customTitle') or custom
        elif o.get('type') == 'ai-title':
            ai = o.get('aiTitle') or ai
    return custom or ai


def build_turns(path: Path):
    """Groups entries into turns: each user prompt with the assistant text that follows it.

    Returns (turns, session title). Within a turn, an assistant text is a "reply to a background event" (folded away) when
    it directly follows a task notification / local command with no tool call in between
    and is short; everything else is the assistant's own stream of work, whose last text is
    the answer. Subagent hand-backs and images are part of the work, not events.
    """
    turns = []
    cur = None
    entries = [o for o in load_entries(path) if not o.get('isSidechain')]
    # `!` shell commands typed in the prompt box are recorded both as <bash-input> and as a
    # prompt-like entry: collect them so the echoes are not listed as prompts
    shell_cmds = set()
    for o in entries:
        if o.get('type') == 'user':
            txt = text_of(o.get('message', {}).get('content')).strip()
            for m in re.finditer(r'<bash-input>(.*?)</bash-input>', txt, re.S):
                shell_cmds.add(m.group(1).strip())
    for o in entries:
        t = o.get('type')
        if t == 'user':
            kind = classify_user(o)
            if kind == 'prompt' and text_of(o['message']['content']).strip() in shell_cmds:
                kind = 'other'
            if kind in ('prompt', 'summary'):
                cur = dict(kind=kind, time=local_time(o.get('timestamp', '')), key=o.get('uuid') or '',
                    prompt=text_of(o['message']['content']).strip(), texts=[], later=[],
                    n_tools=0, after_event=False, tools_since_event=0)
                turns.append(cur)
            elif cur is not None:
                c = o.get('message', {}).get('content')
                if isinstance(c, list) and any(isinstance(b, dict) and b.get('type') == 'tool_result' for b in c):
                    continue   # tool results are part of the assistant's own turn
                ev = text_of(c).strip()
                if ev.startswith(('<task-notification', '<system-reminder', '<local-command',
                        '<command-name', '<bash-')):
                    cur['after_event'] = True; cur['tools_since_event'] = 0
                    cur['later'].append(('event', ev[:300]))
                else:
                    cur['after_event'] = False
                    cur['texts'].append(('event', ev[:300]))
        elif t == 'assistant' and cur is not None:
            c = o.get('message', {}).get('content') or []
            n_tools = sum(1 for b in c if isinstance(b, dict) and b.get('type') == 'tool_use') if isinstance(c, list) else 0
            txt = text_of(c).strip()
            if txt:
                reply = cur['after_event'] and cur['tools_since_event'] == 0 and len(txt) < 600
                (cur['later'] if reply else cur['texts']).append(('assistant', txt))
                if not reply:
                    cur['after_event'] = False
            cur['n_tools'] += n_tools
            cur['tools_since_event'] += n_tools
    for turn in turns:
        idx = [i for i, (k, _) in enumerate(turn['texts']) if k == 'assistant']
        if idx:
            # the answer: the last substantial text of the assistant's own stream (short
            # status lines posted after it while waiting on background work do not count)
            longest = max(len(turn['texts'][i][1]) for i in idx)
            pick = [i for i in idx if len(turn['texts'][i][1]) >= 0.5 * longest][-1]
            turn['answer'] = turn['texts'][pick][1]
            turn['intermediate'] = turn['texts'][:pick]
            turn['updates'] = turn['texts'][pick + 1:]
        else:
            turn['answer'] = ''; turn['intermediate'] = turn['texts']; turn['updates'] = []
    return turns, session_title(entries)


# --- minimal markdown -> HTML (headings, lists, tables, code, bold / italic / links)
def inline(s: str) -> str:
    s = html.escape(s, quote=False)
    s = re.sub(r'`([^`]+)`', r'<code>\1</code>', s)
    s = re.sub(r'\*\*(.+?)\*\*', r'<b>\1</b>', s)
    s = re.sub(r'(?<![*\w])\*([^*\n]+?)\*(?![*\w])', r'<i>\1</i>', s)
    s = re.sub(r'\[([^\]]+)\]\((https?://[^)\s]+)\)', r'<a href="\2">\1</a>', s)
    s = re.sub(r'(?<![">\w])(https?://[^\s<)]+)', r'<a href="\1">\1</a>', s)
    return s


def md(text: str) -> str:
    lines = text.split('\n'); out = []; i = 0
    while i < len(lines):
        s = lines[i].rstrip()
        if s.strip() == '':
            i += 1; continue
        if s.startswith('```'):
            j = i + 1; buf = []
            while j < len(lines) and not lines[j].startswith('```'):
                buf.append(lines[j]); j += 1
            out.append('<pre>' + html.escape('\n'.join(buf)) + '</pre>'); i = j + 1; continue
        m = re.match(r'^(#{1,6}) (.*)', s)
        if m:
            lvl = min(len(m.group(1)) + 2, 6)
            out.append(f'<h{lvl}>{inline(m.group(2))}</h{lvl}>'); i += 1; continue
        if s.lstrip().startswith('|'):
            rows = []
            while i < len(lines) and lines[i].strip().startswith('|'):
                rows.append([c.strip() for c in lines[i].strip().strip('|').split('|')]); i += 1
            body = [r for r in rows[1:] if not all(re.fullmatch(r':?-{2,}:?', c) for c in r)]
            t = ['<table><tr>' + ''.join(f'<th>{inline(c)}</th>' for c in rows[0]) + '</tr>']
            t += ['<tr>' + ''.join(f'<td>{inline(c)}</td>' for c in r) + '</tr>' for r in body]
            out.append('\n'.join(t) + '</table>'); continue
        mo = re.match(r'^(\s*)(\d+)\. (.*)', s); mb = re.match(r'^(\s*)[-*] (.*)', s)
        if mo or mb:
            tag = 'ol' if mo else 'ul'; items = []
            start = f' start="{mo.group(2)}"' if mo and mo.group(2) != '1' else ''
            rx = re.compile(r'^(\s*)\d+\. (.*)') if mo else re.compile(r'^(\s*)[-*] (.*)')
            while i < len(lines) and rx.match(lines[i].rstrip()):
                item = rx.match(lines[i].rstrip()).group(2); i += 1
                while i < len(lines) and lines[i].strip() and not rx.match(lines[i].rstrip()) \
                        and not re.match(r'^(\s*)([-*]|\d+\.) ', lines[i]) and not lines[i].startswith(('#', '|', '```')):
                    item += ' ' + lines[i].strip(); i += 1
                items.append(f'<li>{inline(item)}</li>')
                j = i
                while j < len(lines) and not lines[j].strip():
                    j += 1
                if j < len(lines) and rx.match(lines[j].rstrip()):
                    i = j
            out.append(f'<{tag}{start}>' + ''.join(items) + f'</{tag}>'); continue
        para = [s]; i += 1
        while i < len(lines) and lines[i].strip() and not re.match(r'^(\s*)([-*]|\d+\.) |^#|^\||^```', lines[i]):
            para.append(lines[i].strip()); i += 1
        out.append(f'<p>{inline(" ".join(para))}</p>')
    return '\n'.join(out)


