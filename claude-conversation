def turn_labels(turns) -> list:
    """Each turn's label on the pages: "<k>/<number of prompts>" for prompts, else "context summary"."""
    n = sum(t['kind'] == 'prompt' for t in turns)
    labels, k = [], 0
    for t in turns:
        k += t['kind'] == 'prompt'
        labels.append(f'{k}/{n}' if t['kind'] == 'prompt' else 'context summary')
    return labels


def turn_rows(turns) -> list:
    """[id on the page, label, prompt ('' for context summaries), final answer, time, key] for each turn.
    The key (the prompt's uuid in the transcript, else the id) is what stars and hidden turns are saved under.
    """
    return [[f't{i}', label, t['prompt'] if t['kind'] == 'prompt' else '', t['answer'], t['time'], t.get('key') or f't{i}']
        for i, (t, label) in enumerate(zip(turns, turn_labels(turns)))]


def search_js(turns, session: str) -> str:
    """The session's turn_rows(), as a script for searches, loaded once something is typed (a script,
    unlike fetch(), can also be loaded by pages opened as files). The server reads it to save marks.
    """
    return f'ccSearch({json.dumps({"session": session, "turns": turn_rows(turns)})});\n'


def search_rows(path: Path) -> list:
    """The turn_rows() in a search_js() file ([] if it is missing or unreadable)."""
    try:
        text = path.read_text()
        return json.loads(text[text.index('(') + 1:text.rindex(')')])['turns']
    except (OSError, ValueError, KeyError):
        return []


@contextlib.contextmanager
def marks_lock():
    """Held while reading and rewriting the MARKS files and <page>.marks.js files (by the server, and by
    runs regenerating pages).
    """
    OUT_ROOT.mkdir(parents=True, exist_ok=True)
    with (OUT_ROOT / '.marks.lock').open('w') as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def load_marks(kind: str) -> dict:
    """MARKS[kind]: {"rev": number of changes so far, "entries": [one per marked turn, oldest first]}."""
    try:
        data = json.loads(MARKS[kind].read_text())
        return dict(rev=int(data.get('rev', 0)), entries=list(data.get('entries', [])))
    except (OSError, ValueError, AttributeError):
        return dict(rev=0, entries=[])


def save_marks(kind: str, data: dict) -> None:
    write_atomic(MARKS[kind], json.dumps(data, indent=1, ensure_ascii=False) + '\n')


def write_marks_js(page: Path, session: str, data: dict) -> dict:
    """Writes <page>.marks.js, for its page and searches of it, if that changes it: the keys of the
    session's turns of each kind in data ({kind: load_marks(kind)}) and each kind's rev, as
    ccMarks({"session": ..., "star": {"keys": [...], "rev": ...}, "hide": {...}}). Returns that object.
    """
    marks = dict(session=session, **{kind: dict(keys=[e['key'] for e in d['entries'] if e.get('session') == session],
        rev=d['rev']) for kind, d in data.items()})
    path, text = page.with_suffix('.marks.js'), f'ccMarks({json.dumps(marks)});\n'
    try:
        same = path.read_text() == text
    except OSError:
        same = False
    if not same:
        write_atomic(path, text)
    page.with_suffix('.stars.js').unlink(missing_ok=True)   # what earlier versions wrote instead
    return marks


def read_marks_js(page: Path) -> dict | None:
    """The object in <page>.marks.js (None if missing)."""
    try:
        text = page.with_suffix('.marks.js').read_text()
        return json.loads(text[text.index('(') + 1:text.rindex(')')])
    except (OSError, ValueError):
        return None


def mark_entry(page: Path, info: dict, row: list) -> dict:
    """What the MARKS files keep of a turn (a turn_rows() row of the session page at page)."""
    return dict(project=info.get('project', ''), session=page.stem, name=info.get('name', ''),
        page=page.relative_to(OUT_ROOT).as_posix() if page.is_relative_to(OUT_ROOT) else str(page),
        turn=row[0], key=row[5], label=row[1], time=row[4], prompt=row[2], answer=row[3])


def set_mark(kind: str, page: Path, key: str, turn: str, on: bool) -> dict | None:
    """Marks (on) or unmarks as kind ('star' or 'hide') the turn with key (or else the id turn) of the
    session page at page, in MARKS[kind] and <page>.marks.js. Returns write_marks_js()'s object, or None if
    the turn is not in the page's search_js() file.
    """
    rows = search_rows(page.with_suffix('.search.js'))
    row = next((r for r in rows if len(r) > 5 and r[5] == key), None) or next((r for r in rows if r[0] == turn), None)
    if row is None:
        return None
    if len(row) < 6:   # from before rows had a time and a key
        row = [*row[:4], '', key]
    with marks_lock():
        data = {k: load_marks(k) for k in MARKS}
        d = data[kind]
        d['entries'] = [e for e in d['entries'] if not (e.get('session') == page.stem and e.get('key') == row[5])]
        if on:
            d['entries'].append(dict(mark_entry(page, session_info(page) or {}, row),
                **{MARKED_FIELD[kind]: f'{dt.datetime.now():%Y-%m-%d %H:%M:%S}'}))
        d['rev'] += 1
        save_marks(kind, d)
        return write_marks_js(page, page.stem, data)


def sync_marks(page: Path, session: str, name: str, rows: list) -> None:
    """After a run rewrote a session page: updates the prompts and answers (etc.) of the session's entries
    in the MARKS files from its turn_rows(), and writes <page>.marks.js.
    """
    with marks_lock():
        data = {k: load_marks(k) for k in MARKS}
        by_key = {r[5]: r for r in rows}
        for kind, d in data.items():
            changed = False
            for e in d['entries']:
                row = by_key.get(e.get('key')) if e.get('session') == session else None
                if row:
                    new = dict(e, name=name, turn=row[0], label=row[1], time=row[4], prompt=row[2], answer=row[3])
                    if new != e:
                        e.update(new); changed = True
            if changed:
                save_marks(kind, d)
        write_marks_js(page, session, data)


def render(turns, name: str, source: Path, project: Path, header: str, root: str, marks: str) -> str:
    """The session page (for write_page()). root is the URL of OUT_ROOT relative to the page, and marks
    that of its write_marks_js() file.
    """
    prompts = [t for t in turns if t['kind'] == 'prompt']
    n = len(prompts)
    title = f'{name} · Claude Code session {source.stem[:8]} ({project.name})'
    # metadata for the index page and later runs, kept near the top of the file so it is cheap to read back
    info = dict(project=str(project), session=source.stem, name=name, prompts=n,
        first=prompts[0]['time'] if prompts else '', last=prompts[-1]['time'] if prompts else '')
    meta = f'<meta name="claude-conversation" content="{html.escape(json.dumps(info), quote=True)}">'
    nav, body = [], []
    # (button labels are CSS, from data-l, so that the page's search does not find them)
    star = '<button class="star" data-l="\u2606" onclick="mark(this,\'star\')"></button>'
    hide = '<button class="hide" data-l="hide" onclick="mark(this,\'hide\')"></button>'
    copy = lambda id: f'<button class="copy" data-l="copy" onclick="cp(\'{id}\',this)"></button>'
    for i, (t, label) in enumerate(zip(turns, turn_labels(turns))):
        tid, key = f't{i}', html.escape(t.get('key') or f't{i}')
        snippet = html.escape(t['prompt'][:90].replace('\n', ' '))
        nav.append(f'<a href="#{tid}" data-i="{i}" data-key="{key}"><span class="st">\u2605 </span><b>{label}</b> '
            f'<small>{t["time"]}</small><br>{snippet}</a>')
        raw = html.escape(t['answer'], quote=True)
        inter = ''
        def fold(items, title):
            parts = ''.join(f'<div class="ev"><b>{"assistant" if kind == "assistant" else "event"}:</b> '
                f'{html.escape(x[:1500])}{"..." if len(x) > 1500 else ""}</div>' for kind, x in items)
            return f'<details><summary>{title}</summary>{parts}</details>'
        if t['intermediate']:
            inter += fold(t['intermediate'], f'{len(t["intermediate"])} progress notes before the answer ({t["n_tools"]} tool calls in this turn)')
        if t.get('updates'):
            inter += fold(t['updates'], f'{len(t["updates"])} later updates in this turn')
        if t['later']:
            n_ev = sum(1 for k, _ in t['later'] if k == 'event'); n_as = len(t['later']) - n_ev
            inter += fold(t['later'], f'{n_ev} background events after the answer, {n_as} short replies to them')
        prompt_html = html.escape(t['prompt'] if t['kind'] == 'prompt' else t['prompt'][:600] + ' ...')
        body.append(f'<section class="turn {t["kind"]}-turn" id="{tid}" data-key="{key}">'
            f'<div class="prompt" id="p{i}" data-raw="{html.escape(t["prompt"], quote=True)}"><div class="k">{star}{hide}{copy(f"p{i}")}'
            f'{label} · {t["time"]}</div>{prompt_html}</div>'
            f'<div class="answer" id="a{i}" data-raw="{raw}">{star}{copy(f"a{i}")}'
            f'{md(t["answer"]) if t["answer"] else "<p><i>(no final text; see the notes below)</i></p>"}</div>{inter}</section>')
    return (f'<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">{stamp_meta()}{meta}<title>{html.escape(title)}</title>'
        f'<style>{CSS}</style>{HEAD_JS}<script src="{html.escape(urllib.parse.quote(marks))}"></script>'
        '<script>if(ccMarksQ.length)ccHideStyle((ccMarksQ[0].hide||{}).keys||[])</script>'
        f'</head><body data-root="{html.escape(root)}" data-session="{html.escape(source.stem)}">'
        f'{header}<div class="cols"><nav><input id="q" placeholder="search prompts and answers" oninput="flt()">'
        '<div class="opts"><label><input type="checkbox" id="starfirst" checked onchange="sortNav()">starred first</label>'
        '<label><input type="checkbox" id="showhid" onchange="showHidden()">show hidden</label> <small id="nhid"></small></div>'
        + '\n'.join(nav) + f'</nav><main><div class="meta"><button id="navbtn" onclick="toggleNav()"></button>{html.escape(title)} · {n} prompts · source {html.escape(str(source))}</div>'
        '<div class="scroll"><div id="others" hidden></div>' + '\n'.join(body) + f'</div></main></div><script>{SEARCH_JS}{JS}{live_js()}</script></body></html>')


