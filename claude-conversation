# The index's search: on the first query, loads every session's <session>.search.js, then lists under
# each session row the turns whose prompt or answer contains the query (case-insensitively), leaving out
# hidden turns unless "show hidden" is ticked. An empty box shows the plain list again. The query survives
# reloads. Each session's <session>.marks.js is loaded with the page (and again when it is shown), for the
# number of hidden turns.
INDEX_JS = """
const Q=document.getElementById('q'),SH=document.getElementById('showhid'),MAX=6;let loaded=false;
try{SH.checked=localStorage.ccShowHidden==='1';}catch(e){}
document.documentElement.classList.toggle('hidehid',!SH.checked);
SH.onchange=()=>{try{localStorage.ccShowHidden=SH.checked?'1':'';}catch(e){}document.documentElement.classList.toggle('hidehid',!SH.checked);flt();};
async function flt(){
 const q=Q.value.trim().toLowerCase(),rows=[...document.querySelectorAll('tr[data-s]')];
 try{sessionStorage.ccIndexQ=Q.value;}catch(e){}
 if(!q){rows.forEach(r=>{r.classList.remove('nomatch');r.nextElementSibling.hidden=true;});return;}
 if(!loaded)rows.forEach(r=>{r.nextElementSibling.hidden=false;r.nextElementSibling.firstElementChild.textContent='searching...';});
 await Promise.all(rows.map(r=>ccLoad(r.dataset.search)));loaded=true;
 if(Q.value.trim().toLowerCase()!==q)return;   // typed on meanwhile
 for(const r of rows){
  const hits=r.nextElementSibling,href=esc(r.dataset.href),m=ccMatches(r.dataset.session,q),nh=ccMatches(r.dataset.session,q,true).length-m.length;
  const lines=m.slice(0,MAX).map(([t,what,text,at])=>`<div><a href="${href}#${t.id}">${t.label} ${what}</a> ${snip(text,at,q.length)}</div>`);
  if(m.length>MAX)lines.push(`<div><a href="${href}#q=${encodeURIComponent(Q.value.trim())}">${m.length-MAX} more (open the session with this search)</a></div>`);
  hits.firstElementChild.innerHTML=!(r.dataset.session in ccData)?'<i>not searchable: re-run claude-conversation in its project</i>'
   :m.length?lines.join(''):'no matches in prompts or answers'+(nh?` (except ${nh} match${nh>1?'es':''} in hidden turns)`:'');
  r.classList.toggle('nomatch',!m.length&&!r.innerText.toLowerCase().includes(q));hits.hidden=false;}
}
async function hiddenCount(){
 const rows=[...document.querySelectorAll('tr[data-s]')];
 await Promise.all(rows.map(r=>ccLoadNow(r.dataset.marks)));
 const n=rows.reduce((n,r)=>n+(((ccMarksOf[r.dataset.session]||{}).hide||{}).keys||[]).length,0);
 document.getElementById('nhid').textContent='('+n+' hidden turn'+(n==1?'':'s')+' in these sessions)';
 if(Q.value.trim())flt();}
try{if(sessionStorage.ccIndexQ){Q.value=sessionStorage.ccIndexQ;flt();}}catch(e){}
hiddenCount();document.addEventListener('visibilitychange',()=>{if(!document.hidden)hiddenCount();});
"""


def session_info(page: Path):
    """The metadata render() embeds in a session page (None if page is missing or another HTML file)."""
    if not page.exists():
        return None
    m = re.search(r'<meta name="claude-conversation" content="([^"]*)">', page.open(errors='replace').read(4000))
    try:
        return json.loads(html.unescape(m.group(1))) if m else None
    except ValueError:
        return None


def index_page(header: str, keep=None, note: str = '') -> tuple:
    """The index page (for write_page()) linking every session page under OUT_ROOT for which
    keep(project slug, session id) is true (all by default), grouped by project with the most recently
    active first, below header, and the list of those sessions (for sessions_js()). note replaces the
    line's hint on adding sessions. Returns (page, sessions, number of projects).
    """
    by_project = {}
    for page in OUT_ROOT.glob('*/*.html'):
        if keep and not keep(page.parent.name, page.stem):
            continue
        info = session_info(page)
        if info:
            info['href'] = str(page.relative_to(OUT_ROOT))
            info['search'] = f'{page.relative_to(OUT_ROOT).with_suffix(".search.js")}?v={page_stamp(page)[0] or ""}'
            info['marks'] = str(page.relative_to(OUT_ROOT).with_suffix('.marks.js'))
            by_project.setdefault(info['project'], []).append(info)
    parts = []
    for project, infos in sorted(by_project.items(), key=lambda kv: max(i['last'] for i in kv[1]), reverse=True):
        rows = ''.join(f'<tr data-s data-session="{html.escape(i["session"])}" data-href="{html.escape(i["href"])}" '
            f'data-search="{html.escape(i["search"])}" data-marks="{html.escape(i["marks"])}"><td><a href="{html.escape(i["href"])}">{html.escape(i["name"])}</a></td>'
            f'<td class="n">{i["prompts"]}</td><td>{i["first"]}</td><td>{i["last"]}</td><td><small>{i["session"][:8]}</small></td></tr>'
            f'<tr class="hits" hidden><td colspan="5"></td></tr>'
            for i in sorted(infos, key=lambda i: i['last'], reverse=True))
        parts.append(f'<h2>{html.escape(project)}</h2><table><tr><th>session</th><th class="n">prompts</th>'
            f'<th>first prompt</th><th>last prompt</th><th>id</th></tr>{rows}</table>')
    n = sum(len(v) for v in by_project.values())
    note = html.escape(note or 'run claude-conversation in a project to add or refresh its sessions')
    page = (f'<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">{stamp_meta()}<title>Claude Code sessions</title>'
        f'<style>{INDEX_CSS}</style></head><body>{header}<div class="meta">{plural(n, "rendered session")} in '
        f'{plural(len(by_project), "project")} · {note}</div>'
        f'<input id="q" placeholder="search all prompts and answers (and session names)" oninput="flt()">'
        '<div class="opts"><label><input type="checkbox" id="showhid">show hidden turns</label> <small id="nhid"></small></div>'
        + '\n'.join(parts)
        + f'<script>{SEARCH_JS}{INDEX_JS}{live_js()}</script></body></html>')
    sessions = [{k: i[k] for k in ('session', 'name', 'project', 'href', 'search')}
        for _, infos in sorted(by_project.items(), key=lambda kv: max(i['last'] for i in kv[1]), reverse=True)
        for i in sorted(infos, key=lambda i: i['last'], reverse=True)]
    return page, sessions, len(by_project)


def sessions_js(sessions: list) -> str:
    """The session list as a script, for session pages' searches of the other sessions."""
    return f'ccSessions({json.dumps(sessions)});\n'


def write_index(header: str):
    """Writes OUT_ROOT/index.html (index_page() of every session) and OUT_ROOT/sessions.js. Returns
    (path, number of sessions, number of projects).
    """
    page, sessions, n_projects = index_page(header)
    out = OUT_ROOT / 'index.html'
    write_page(out, page)
    write_atomic(OUT_ROOT / 'sessions.js', sessions_js(sessions))
    return out, len(sessions), n_projects


def in_scope(scope: list, path: str) -> bool:
    """Whether the server shows the file at URL path (unquoted) under OUT_ROOT: one of a session's files
    (<project slug>/<session id>.*) whose project or session is in scope (a list of dicts with the
    project's directory and slug, and a session id, or None for all its sessions).
    """
    parts = path.strip('/').split('/')
    if len(parts) != 2 or not parts[1] or parts[1].startswith('.'):
        return False
    slug, session = parts[0], parts[1].split('.')[0]
    return any(x['slug'] == slug and x['session'] in (None, session) for x in scope)


def scope_note(scope: list) -> str:
    """What the server shows, for its index page."""
    by_project = {}
    for x in scope:
        by_project.setdefault(x['project'], set()).add(x['session'])
    parts = [p if None in ss else f'{p} ({"session" if len(ss) == 1 else "sessions"} {", ".join(sorted(x[:8] for x in ss))})'
        for p, ss in by_project.items()]
    return 'this server only shows ' + ('; '.join(parts) or 'nothing') + ' (as asked by the --serve runs using it)'


class QuietHandler(http.server.SimpleHTTPRequestHandler):
    """Serves the files of the sessions in the server's scope under OUT_ROOT, and an index page and
    sessions.js listing those only. Also /_alive, which open pages ask whether they have been
    regenerated and for their marks (which tells the server they are open), /_status (the open tabs
    etc., for the command line), and, by POST, /_mark (stars or hides a turn, or undoes that) and /_scope
    (adds a later run's sessions to those shown).
    """
    server_version = 'claude-conversation'   # lets server_status() recognize its own server

    def log_message(self, *args):
        pass

    def end_headers(self):
        self.send_header('Cache-Control', 'no-cache')   # always revalidate: pages must not come from a stale cache
        super().end_headers()

    def do_HEAD(self):
        self.get(head=True)

    def do_GET(self):
        self.get(head=False)

    def get(self, head: bool) -> None:
        srv = self.server
        url = urllib.parse.urlsplit(self.path)
        path = urllib.parse.unquote(url.path)
        if path != '/_status':   # the command line asking does not keep the server up
            srv.last_request = time.monotonic()
        if path == '/_alive':
            q = dict(urllib.parse.parse_qsl(url.query))
            page = urllib.parse.unquote(q.get('page', '/'))
            with srv.lock:
                srv.tabs[q.get('tab', '')] = dict(page=page, client=self.client_address[0],
                    seen=time.monotonic(), version=q.get('v', ''))
            if page in ('/', '/index.html'):
                index = scoped_index(srv)
                return self.send_json({'version': index['version'], 'generated': index['generated'], 'restart': srv.restart})
            if not in_scope(srv.scope, page):
                return self.send_error(404)
            page = Path(self.translate_path(page))
            version, generated = page_stamp(page)
            answer = {'version': version, 'generated': generated, 'restart': srv.restart}
            if marks := read_marks_js(page):
                answer['marks'] = marks
            return self.send_json(answer)
        if path == '/_status':
            return self.send_json({'tabs': open_tabs(srv), 'watch': watch_running(), 'api': SERVER_API, 'scope': srv.scope})
        if path in ('/', '/index.html'):
            return self.send_body(self.fill_title(scoped_index(srv)['page']), 'text/html; charset=utf-8', head)
        if path == '/sessions.js':
            return self.send_body(scoped_index(srv)['sessions'], 'text/javascript; charset=utf-8', head)
        if not in_scope(srv.scope, path):
            return self.send_error(404)
        if path.endswith('.html'):
            try:
                page = Path(self.translate_path(path)).read_bytes()
            except OSError:
                return self.send_error(404)
            return self.send_body(self.fill_title(page), 'text/html; charset=utf-8', head)
        super().do_HEAD() if head else super().do_GET()

    def fill_title(self, page: bytes) -> bytes:
        """page with this server's details in its title line: the address the browser reached it at, the
        host name and the pid (so they are right whichever run wrote the page).
        """
        where = self.headers.get('Host') or server_base(self.server.server_address[1]).removeprefix('http://')
        details = f'served from {where} on {socket.gethostname()} · server pid {os.getpid()} · '
        return page.replace(SERVER_SLOT.encode(), f'<span id="srv">{html.escape(details)}</span>'.encode(), 1)

    def do_POST(self):
        srv = self.server
        srv.last_request = time.monotonic()
        try:
            body = json.loads(self.rfile.read(int(self.headers.get('Content-Length') or 0)) or b'null')
        except ValueError:
            return self.send_error(400)
        path = urllib.parse.urlsplit(self.path).path
        if path == '/_mark' and isinstance(body, dict) and body.get('kind') in MARKS:
            page = urllib.parse.unquote(str(body.get('page', '')))
            if not (page.endswith('.html') and in_scope(srv.scope, page)):
                return self.send_error(404)
            marks = set_mark(body['kind'], Path(self.translate_path(page)), str(body.get('key', '')),
                str(body.get('turn', '')), bool(body.get('on')))
            return self.send_error(404) if marks is None else self.send_json(marks)
        if path == '/_scope' and isinstance(body, list):
            with srv.lock:
                for x in body:
                    x = {k: x.get(k) for k in ('project', 'slug', 'session')}
                    if x not in srv.scope:
                        srv.scope.append(x)
            return self.send_json({'scope': srv.scope})
        self.send_error(404)

    def send_json(self, obj) -> None:
        self.send_body(json.dumps(obj).encode(), 'application/json', False)

    def send_body(self, body: bytes, ctype: str, head: bool) -> None:
        self.send_response(200)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        if not head:
            self.wfile.write(body)


def scoped_index(srv) -> dict:
    """The index page (with its version and generation time) and sessions.js the server sends: those of
    the sessions in its scope. Rebuilt when index.html (rewritten by every run) or the scope changes.
    """
    index = OUT_ROOT / 'index.html'
    try:
        mtime = index.stat().st_mtime_ns
    except OSError:
        mtime = None
    with srv.lock:
        scope = list(srv.scope)
        key = (mtime, json.dumps(scope))
        if srv.index_cache and srv.index_cache['key'] == key:
            return srv.index_cache
    page, sessions, _ = index_page(header_html(),
        lambda slug, session: in_scope(scope, f'/{slug}/{session}.html'), scope_note(scope))
    text, version, generated = stamp_page(page, page_stamp(index)[1])
    cache = dict(key=key, page=text.encode(), version=version, generated=generated, sessions=sessions_js(sessions).encode())
    with srv.lock:
        srv.index_cache = cache
    return cache


def open_tabs(srv) -> list:
    """The tabs that asked /_alive within TAB_TIMEOUT (forgetting older ones), with how long ago."""
    now = time.monotonic()
    with srv.lock:
        for tab in [t for t, x in srv.tabs.items() if now - x['seen'] > TAB_TIMEOUT]:
            del srv.tabs[tab]
        return [dict(x, seen=round(now - x['seen']), tab=t) for t, x in srv.tabs.items()]


def script_runs() -> list:
    """(pid, parsed arguments) of each run of this script on this machine (not servers), from /proc."""
    name, runs = os.path.basename(__file__), []
    for d in Path('/proc').iterdir():
        if not d.name.isdigit():
            continue
        try:
            argv = (d / 'cmdline').read_bytes().decode(errors='replace').split('\0')[:-1]
        except OSError:
            continue
        # the script run by python (directly or through its #!), not e.g. an editor or a shell command line
        i = next((i for i, a in enumerate(argv[:2]) if os.path.basename(a) == name), None)
        if i is None or (i == 1 and not os.path.basename(argv[0]).startswith('python')):
            continue
        try:
            with contextlib.redirect_stderr(io.StringIO()):
                args, _ = arg_parser().parse_known_args(argv[i + 1:])
        except (SystemExit, argparse.ArgumentError):
            continue
        if not args._server:
            runs.append((int(d.name), args))
    return runs


def watch_running() -> bool:
    """Whether a `claude-conversation --watch` run is going on this machine."""
    return any(args.watch for _, args in script_runs())


def other_watch_runs(port: int) -> list:
    """pids of the other --watch --serve runs using the server on port."""
    return [pid for pid, args in script_runs() if pid != os.getpid() and args.watch and args.serve and args.port == port]


def stop_when_idle(srv) -> None:
    """Shuts srv down once it has gone IDLE_TIMEOUT without requests (open pages make one every 2 s,
    or about once a minute when hidden) while no --watch run was going.
    """
    last_watch = time.monotonic()
    while True:
        time.sleep(IDLE_TIMEOUT / 60)
        now = time.monotonic()
        if watch_running():
            last_watch = now
        if now - max(last_watch, srv.last_request) > IDLE_TIMEOUT:
            print(f'{dt.datetime.now():%Y-%m-%d %H:%M:%S} stopping: no page open and no --watch run for '
                f'{IDLE_TIMEOUT // 60} min', flush=True)
            return srv.shutdown()


def run_server(port: int) -> None:
    """Serves OUT_ROOT on all interfaces (the process that --serve starts) until killed, or until
    stop_when_idle() stops it.
    """
    handler = functools.partial(QuietHandler, directory=str(OUT_ROOT))
    srv = http.server.ThreadingHTTPServer(('', port), handler)
    srv.tabs, srv.lock, srv.last_request, srv.index_cache = {}, threading.Lock(), time.monotonic(), None
    # both set by ensure_server()
    srv.restart = os.environ.get('CLAUDE_CONVERSATION_RESTART', '')
    srv.scope = json.loads(os.environ.get('CLAUDE_CONVERSATION_SCOPE') or '[]')
    threading.Thread(target=stop_when_idle, args=(srv,), daemon=True).start()
    srv.serve_forever()
    pidfile = server_files(port)[0]
    try:
        if pidfile.read_text().strip() == str(os.getpid()):
            pidfile.unlink()
    except OSError:
        pass


def server_status(port: int) -> str:
    """'ours' (this script's server answers on port), 'other' (something else does) or 'none'."""
    try:
        conn = http.client.HTTPConnection('127.0.0.1', port, timeout=2)
        conn.request('HEAD', '/')
        server = conn.getresponse().getheader('Server') or ''
    except OSError:
        return 'none'
    except http.client.HTTPException:
        return 'other'
    return 'ours' if server.startswith(QuietHandler.server_version) else 'other'


def server_files(port: int):
    """(pid file, log file) of the server on port."""
    return (Path.home() / '.claude' / f'conversation-server-{port}.pid',
        Path.home() / '.claude' / f'conversation-server-{port}.log')


def restart_command(extra: list) -> str:
    """A shell command repeating this run from the same directory, with the arguments extra added (pages
    show it when the server they came from is gone).
    """
    prog = sys.argv[0]
    on_path = shutil.which(os.path.basename(prog))
    if on_path and os.path.samefile(on_path, prog):
        prog = os.path.basename(prog)
    return f'cd {shlex.quote(os.getcwd())} && {shlex.join([prog, *sys.argv[1:], *extra])}'


def ensure_server(port: int, scope: list, extra: list) -> str:
    """Starts the background server on port, to show the sessions in scope (see in_scope()), unless it is
    running, in which case it adds them to those it shows. A running server from an older version of this
    script (one without what pages now ask of it) is replaced. extra: for restart_command(). Returns
    'started' or 'running'.
    """
    status = server_status(port)
    if status == 'ours':
        if (server_state(port) or {}).get('api') == SERVER_API:
            try:
                post_json(port, '/_scope', scope)
            except OSError as e:
                sys.exit(f'could not add the sessions of this run to those the server on port {port} shows: {e}')
            return 'running'
        stopped = stop_server(port)
        if server_status(port) != 'none':
            sys.exit(f'the server on port {port} is from an older version of this script, and could not be replaced: {stopped}')
        print(f'the server on port {port} was from an older version of this script: {stopped}, starting the current one',
            file=sys.stderr)
        status = 'none'
    if status == 'other':
        sys.exit(f'port {port} is in use by another program (pick another with --port)')
    pidfile, logfile = server_files(port)
    OUT_ROOT.mkdir(parents=True, exist_ok=True)
    # own session and no inherited stdio, so it outlives this process and does not hold open the
    # pipe of whatever ran it (e.g. Claude Code's `!`, which would otherwise wait for it)
    with logfile.open('w') as log:
        proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), '--_server', str(port)],
            stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
            env=dict(os.environ, CLAUDE_CONVERSATION_RESTART=restart_command(extra), CLAUDE_CONVERSATION_SCOPE=json.dumps(scope)))
    for _ in range(50):
        if server_status(port) == 'ours':
            pidfile.write_text(f'{proc.pid}\n')
            return 'started'
        if proc.poll() is not None:
            break
        time.sleep(0.1)
    sys.exit(f'could not start the server on port {port} (see {logfile})')


def server_pid(port: int) -> int | None:
    """pid of the server on port, from its pid file (None if missing or not this script's server)."""
    pidfile, _ = server_files(port)
    try:
        pid = int(pidfile.read_text())
        if b'--_server' in Path(f'/proc/{pid}/cmdline').read_bytes():
            return pid
    except (OSError, ValueError):
        pass
    return None


def stop_server(port: int) -> str:
    pid = server_pid(port)
    if pid is None:
        if server_status(port) == 'ours':
            return f'server on port {port} has no valid pid file ({server_files(port)[0]}): kill it by hand'
        return f'no server running on port {port}'
    os.kill(pid, signal.SIGTERM)
    for _ in range(30):
        if server_status(port) != 'ours':
            server_files(port)[0].unlink()
            return f'stopped server on port {port} (pid {pid})'
        time.sleep(0.1)
    return f'sent SIGTERM to the server on port {port} (pid {pid}), but it is still answering'


def stop_command(port: int) -> str:
    return 'claude-conversation --stop-server' + ('' if port == SERVER_PORT else f' --port {port}')


def server_state(port: int) -> dict | None:
    """The server's /_status answer (None if it does not answer)."""
    try:
        with urllib.request.urlopen(f'http://127.0.0.1:{port}/_status', timeout=2) as r:
            return json.load(r)
    except (OSError, ValueError):
        return None


def server_tabs(port: int) -> list | None:
    """The tabs that have the server's pages open (None if it does not say)."""
    return (server_state(port) or {}).get('tabs')


def post_json(port: int, path: str, obj) -> None:
    req = urllib.request.Request(f'http://127.0.0.1:{port}{path}', json.dumps(obj).encode(),
        {'Content-Type': 'application/json'})
    with urllib.request.urlopen(req, timeout=2):
        pass


IDLE_NOTE = f'it stops itself after {IDLE_TIMEOUT // 60} min with no page open and no --watch run'


def still_running(port: int) -> str:
    return (f'the server on port {port} (pid {server_pid(port) or "unknown"}) is still running ({IDLE_NOTE}); '
        f'stop it now with: {stop_command(port)}')


def at_exit_with_server(port: int, started: bool, watch: bool, asked: list) -> None:
    """atexit hook of --serve runs, unless the run asked what to do at Ctrl+C (asked is not empty): says
    how to stop the server when a --watch run leaves it running, or when a run in a terminal has just
    started it.
    """
    if asked or server_status(port) != 'ours':
        return
    if watch:
        print(still_running(port), file=sys.stderr)
    elif started and sys.stdin.isatty() and sys.stderr.isatty():
        print(f'started the server in the background (pid {server_pid(port)}; {IDLE_NOTE}); stop it now with: '
            f'{stop_command(port)}', file=sys.stderr)


def ask_at_ctrl_c(port: int) -> bool:
    """After Ctrl+C in a --watch --serve run in a terminal, asks whether to stop the server and exit (the
    default: anything but "n" or "b", including another Ctrl+C), carry on watching ("n": the question is
    then cleared from the terminal), or exit leaving the server running ("b"). When other --watch --serve
    runs use the server, the question says so and "b" is the default instead (anything but "y" or "n").
    Returns whether to carry on.
    """
    how, others = '', []
    try:
        if server_status(port) != 'ours':
            print(file=sys.stderr)
            return False
        tabs = server_tabs(port)
        tabs = '' if tabs is None else f', {plural(len(tabs), "tab")} open'
        others = other_watch_runs(port)
        # over the ^C the terminal echoed
        if others:
            question = (f'stop the server (port {port}, pid {server_pid(port) or "unknown"}{tabs}; also used by the '
                f'--watch run{"s" if len(others) > 1 else ""} with pid {", ".join(map(str, others))}) and exit? '
                'y / n: keep watching / B: leave it running in the background ')
        else:
            question = (f'stop the server (port {port}, pid {server_pid(port) or "unknown"}{tabs}) and exit? '
                'Y / n: keep watching / b: leave it running in the background ')
        print('\r\x1b[K' + question, end='', file=sys.stderr, flush=True)
        answer = input()
    except KeyboardInterrupt:
        answer, how = '', 'Ctrl+C at the prompt: '
        print(file=sys.stderr)
    except EOFError:
        answer = ''
        print(file=sys.stderr)
    choice = answer.strip().lower()
    if choice in ('n', 'no'):   # clear the question and the answer (as wrapped by the terminal)
        rows = -(-len(question + answer) // max(shutil.get_terminal_size().columns, 1))
        print(f'\x1b[{max(rows, 1)}A\r\x1b[J', end='', file=sys.stderr, flush=True)
        return True
    signal.signal(signal.SIGINT, signal.SIG_IGN)   # answered: let the rest finish
    if choice in ('y', 'yes') if others else choice not in ('b', 'background'):
        print(how + stop_server(port), file=sys.stderr)
    elif others and how:
        print(how + 'left the server running, for the other --watch run', file=sys.stderr)
    # whatever happened above (left running, or stopping it failed), say how to stop it if it is up
    if server_status(port) == 'ours':
        print(still_running(port), file=sys.stderr)
    return False


def server_base(port: int) -> str:
    """http:// URL of OUT_ROOT, at the address SSH reached this machine on (else localhost)."""
    ssh = os.environ.get('SSH_CONNECTION', '').split()
    host = ssh[2] if len(ssh) == 4 else 'localhost'
    return f'http://{f"[{host}]" if ":" in host else host}:{port}'


def url_for(path: Path, base: str | None) -> str:
    """http:// URL of path under the server at base when served (it is within OUT_ROOT), else file://."""
    path = path.resolve()
    if base and path.is_relative_to(OUT_ROOT.resolve()):
        rel = path.relative_to(OUT_ROOT.resolve()).as_posix()
        return f'{base}/' + ('' if rel == 'index.html' else urllib.parse.quote(rel))
    return path.as_uri()


def plural(n: int, word: str) -> str:
    return f'{n} {word}{"" if n == 1 else "s"}'


def transcript_project(path: Path) -> Path | None:
    """The directory a transcript's session was started in (its first entry's cwd; None if it has none,
    as in transcripts without any messages).
    """
    for o in load_entries(path):
        if o.get('cwd'):
            return Path(o['cwd'])
    return None


def find_sessions(project_dir: Path):
    return sorted(project_dir.glob('*.jsonl'), key=lambda p: p.stat().st_mtime, reverse=True)


def projects_below(base: Path, depth: int) -> tuple:
    """The projects (directories Claude Code sessions were started in) that are base or at most depth
    directories below it (any depth if depth is 0), as [(directory, its folder under PROJECTS)], and how
    many more there are further down.
    """
    prefix, found, deeper = project_slug(base), [], 0
    for folder in sorted(PROJECTS.iterdir()) if PROJECTS.is_dir() else []:
        if not (folder.name.startswith(prefix) and folder.is_dir()):
            continue
        # folder names lose which characters were '/': the real directory is in the transcripts
        project = next(filter(None, map(transcript_project, find_sessions(folder))), None)
        if project is None or not project.is_relative_to(base):
            continue
        if depth and len(project.relative_to(base).parts) > depth:
            deeper += 1
        else:
            found.append((project, folder))
    return found, deeper


class Sessions:
    """The sessions a run renders (see the help), picked again by each --watch pass where that can change
    (not for the Claude Code session the run is part of, -s with an id, or -j). pick() returns them as [(transcript,
    project directory, its folder name under PROJECTS, which is also its folder under OUT_ROOT)]. notes
    has what the first pick() found worth saying, and extra the arguments for restart_command().
    """
    def __init__(self, args):
        self.args, self.notes, self.extra, self.fixed, self.first = args, [], [], None, True
        if args.jsonl:
            project = transcript_project(args.jsonl)
            if project is None:
                sys.exit(f'{args.jsonl} does not say which project it is from (it has no messages)')
            self.fixed = [(args.jsonl, project, project_slug(project))]
            return
        here = project = None   # the transcript of the Claude Code session this is run from, and its project
        if not args.project and (sid := os.environ.get('CLAUDE_CODE_SESSION_ID')):
            here = next(PROJECTS.glob(f'*/{glob.escape(sid)}.jsonl'), None)
            project = here and transcript_project(here)
        if args.project:
            self.base = args.project.resolve()
        elif project:
            self.base, self.extra = project, ['-p', str(project)]   # (restarting from a terminal)
            if args.session == '' and not args.recursive:   # -s alone: this session
                self.fixed = [(here, project, here.parent.name)]
                return
        else:
            self.base = Path.cwd().resolve()
        if args.recursive or (PROJECTS / project_slug(self.base)).is_dir():
            return
        if args.project:
            sys.exit(f'no Claude Code session was started in {self.base} (no {PROJECTS / project_slug(self.base)})')
        up = next((d for d in self.base.parents if (PROJECTS / project_slug(d)).is_dir()), None)
        below = len(projects_below(self.base, 0)[0])
        hint = f' (-r renders the {plural(below, "project")} below it)' if below else ''
        if up is None:
            sys.exit(f'no Claude Code session was started in {self.base} or in a directory above it{hint}')
        self.notes.append(f'note: no Claude Code session was started in {self.base}; rendering those of {up}, '
            f'the nearest directory above it with some{hint}')
        self.base = up

    def pick(self) -> list:
        if self.fixed is not None:
            return self.fixed
        args = self.args
        if args.recursive:
            projects, deeper = projects_below(self.base, RECURSE_DEPTH if args.depth is None else args.depth)
            if args.depth is None and self.first:
                left = f' ({plural(deeper, "project")} further down left out)' if deeper else ''
                self.notes.append(f'note: -r looks at most {RECURSE_DEPTH} directories below {self.base}{left}; '
                    '-d N to change that, -d 0 for no limit')
        else:
            projects = [(self.base, PROJECTS / project_slug(self.base))]
        picked = []
        for project, folder in projects:
            files = find_sessions(folder)
            if args.session == '':   # -s alone: the latest
                files = files[:1]
            elif args.session:
                files = [f for f in files if f.stem.startswith(args.session)]
            picked += [(f, project, folder.name) for f in files]
        if args.session:   # an id (or its start): the most recent match
            picked.sort(key=lambda x: x[0].stat().st_mtime, reverse=True)
            if len(picked) > 1:
                self.notes.append(f'note: {len(picked)} sessions start with "{args.session}"; rendering the most '
                    f'recently active one, {picked[0][0].stem}')
            self.fixed = picked = picked[:1]
        self.first = False
        return picked


def unserved_warnings(port: int, pages: list) -> list:
    """For each server of this script that is running (on port, or on another one, as its pid file says)
    while this run (without --serve) did not add its pages (paths under OUT_ROOT) to those it shows: a
    warning saying so (or a note, if it shows them anyway).
    """
    ports = {port} | {int(m.group(1)) for f in (Path.home() / '.claude').glob('conversation-server-*.pid')
        if (m := re.fullmatch(r'conversation-server-(\d+)[.]pid', f.name))}
    out = []
    for port in sorted(ports):
        if server_status(port) != 'ours':
            continue
        scope = (server_state(port) or {}).get('scope')
        where = f'pid {server_pid(port) or "unknown"}, port {port}: {server_base(port)}/'
        if scope is None or all(in_scope(scope, '/' + page.relative_to(OUT_ROOT).as_posix()) for page in pages):
            out.append(f'note: the claude-conversation server that is running ({where}) shows these pages too')
        else:
            out.append(f'warning: a claude-conversation server is running ({where}), but this run does not add its '
                'pages to those it shows (-e/--serve would)')
    return out


class ParagraphsHelpFormatter(argparse.HelpFormatter):
    """Wraps the description to the terminal's width, like the options' help, but keeps its paragraphs."""
    def _fill_text(self, text, width, indent):
        return '\n\n'.join(textwrap.fill(' '.join(par.split()), width, initial_indent=indent, subsequent_indent=indent,
            break_on_hyphens=False, break_long_words=False) for par in text.split('\n\n'))


def arg_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(description='\n\n'.join(__doc__.split('\n\n')[:2]),
        formatter_class=ParagraphsHelpFormatter)
    ap.add_argument('-p', '--project', type=Path, help='project directory (default: that of the Claude Code session '
        'this is run from, else the current directory, or the nearest one above it that is a project)')
    ap.add_argument('-s', '--session', nargs='?', const='', metavar='ID', help='render only the most recently '
        'active session (of each project, with -r; when run from Claude Code, the session you are in), or with ID the '
        'most recent one whose id starts with ID (default: all the sessions). As it takes an optional value, give it '
        'on its own or last when combining short options (-e -s or -es, not -se)')
    ap.add_argument('-r', '--recursive', action='store_true', help='render the projects in the directory and in those '
        'below it (see -d): all their sessions, or with -s the latest of each (or the most recent match of -s ID)')
    ap.add_argument('-d', '--depth', type=int, metavar='N', help=f'with -r, look at most N directories down '
        f'(default: {RECURSE_DEPTH}; 0: no limit)')
    ap.add_argument('-j', '--jsonl', type=Path, help='a transcript file (one session) to render instead, as part of the '
        'project it was recorded in, wherever this is run (so not with -p, -s or -r); with -e, the server shows only it')
    ap.add_argument('-o', '--open', action='store_true', help='open the printed URL in the browser (xdg-open)')
    ap.add_argument('-w', '--watch', type=int, nargs='?', const=WATCH_INTERVAL, default=0, metavar='SEC',
        help=f'regenerate every SEC seconds (default: {WATCH_INTERVAL}) until Ctrl+C, picking the sessions again each '
        'time (see above); as it takes an optional number, give it on its own or last when combining short options '
        '(-ew, not -we)')
    ap.add_argument('-e', '--serve', action='store_true',
        help='start a background HTTP server (unless running) for the pages of these projects (or only of the '
        'sessions given with -s / -j), and print http:// URLs')
    ap.add_argument('--port', type=int, default=SERVER_PORT, help=f'port for --serve (default: {SERVER_PORT})')
    ap.add_argument('--stop-server', action='store_true', help='stop the --serve server on --port and exit')
    ap.add_argument('--_server', type=int, help=argparse.SUPPRESS)
    ap.add_argument('-v', '--verbose', action='store_true',
        help='print each page path with its session name and prompt count, then the index URL '
        '(default: only one URL, of the page or, for several sessions, of the index)')
    return ap


def main() -> None:
    ap = arg_parser()
    args = ap.parse_args()
    if args._server:
        return run_server(args._server)
    if args.stop_server:
        return print(stop_server(args.port))
    if args.depth is not None and (not args.recursive or args.depth < 0):
        ap.error('-d/--depth goes with -r/--recursive, and is 0 (no limit) or more')
    if args.jsonl and (args.project or args.session is not None or args.recursive):
        ap.error('-j/--jsonl renders that transcript as part of the project it was recorded in: '
            'it cannot be combined with -p, -s or -r')
    sessions = Sessions(args)
    picked = sessions.pick()
    if not picked:
        sys.exit('no matching session')

    def scope_of(picked):   # what the server shows for these: their projects, or with -s / -j only them
        out = []
        for f, project, slug in picked:
            x = dict(project=str(project), slug=slug, session=f.stem if (args.session is not None or args.jsonl) else None)
            if x not in out:
                out.append(x)
        return out
    base, asked = None, []   # asked: set once Ctrl+C in a --watch run asked what to do with the server, and the run is ending
    if args.serve:
        status = ensure_server(args.port, scope_of(picked), sessions.extra)
        atexit.register(at_exit_with_server, args.port, started=status == 'started', watch=bool(args.watch), asked=asked)
        base = server_base(args.port)
        if args.verbose:
            print(f'server {"started" if status == "started" else "already running"}: {base}/', flush=True)
    first_pass, seen = True, set()
    while True:
        try:
            if not first_pass:
                picked = sessions.pick()
                if args.serve:   # (again each time: the server may have been restarted by another run since)
                    with contextlib.suppress(OSError):   # (or be gone)
                        post_json(args.port, '/_scope', scope_of(picked))
            outs = []
            for f, project, slug in picked:
                out = OUT_ROOT / slug / f'{f.stem}.html'
                outs.append(out)
                turns, name = build_turns(f)
                prompts = [t for t in turns if t['kind'] == 'prompt']
                if not name:   # untitled: fall back to the start of the first prompt
                    first = prompts[0]['prompt'].split('\n')[0] if prompts else ''
                    name = (first[:60] + '...') if len(first) > 60 else first or '(empty session)'
                out.parent.mkdir(parents=True, exist_ok=True)
                write_atomic(out.with_suffix('.search.js'), search_js(turns, f.stem))
                write_page(out, render(turns, name, f, project, header_html('../index.html'), '../', out.with_suffix('.marks.js').name))
                sync_marks(out, f.stem, name, turn_rows(turns))
                if args.verbose:
                    print(f'{url_for(out, base) if base else out}  "{name}"  ({plural(len(prompts), "prompt")})', flush=True)
                elif not first_pass and out not in seen:   # e.g. a new session, picked by --watch
                    print(f'new: {url_for(out, base)}  "{name}"', flush=True)
                seen.add(out)
            index, n_sessions, n_projects = write_index(header_html())
            if first_pass:
                for note in sessions.notes + ([] if args.serve else unserved_warnings(args.port, outs)):
                    print(note, file=sys.stderr, flush=True)
            if args.verbose:
                print(f'index of all rendered sessions: {url_for(index, base)}  ({plural(n_sessions, "session")} in {plural(n_projects, "project")})', flush=True)
            elif first_pass:
                print(url_for(outs[0] if len(outs) == 1 else index, base), flush=True)
            if args.open:   # (the URL printed without -v)
                subprocess.Popen(['xdg-open', url_for(outs[0] if len(outs) == 1 else index, base)],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                args.open = False
            first_pass = False
            if not args.watch:
                break
            time.sleep(args.watch)
        except KeyboardInterrupt:   # the way --watch ends: no traceback (and --serve's atexit hook runs)
            if args.serve and args.watch and sys.stdin.isatty() and sys.stderr.isatty():
                if ask_at_ctrl_c(args.port):
                    continue
                asked.append(True)
            else:
                print(file=sys.stderr)
            sys.exit(130)


if __name__ == '__main__':
    main()
