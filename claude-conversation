def session_info(page: Path):
    """The metadata render() embeds in a session page (None if page is missing or another HTML file)."""
    if not page.exists():
        return None
    m = re.search(r'<meta name="claude-conversation" content="([^"]*)">', page.open(errors='replace').read(4000))
    try:
        return json.loads(html.unescape(m.group(1))) if m else None
    except ValueError:
        return None


def write_index(header: str):
    """Writes OUT_ROOT/index.html linking every session page under OUT_ROOT, grouped by project
    with the most recently active first, below header. Returns (path, number of sessions, number of
    projects).
    """
    by_project = {}
    for page in OUT_ROOT.glob('*/*.html'):
        info = session_info(page)
        if info:
            info['href'] = str(page.relative_to(OUT_ROOT))
            by_project.setdefault(info['project'], []).append(info)
    parts = []
    for project, infos in sorted(by_project.items(), key=lambda kv: max(i['last'] for i in kv[1]), reverse=True):
        rows = ''.join(f'<tr data-s><td><a href="{html.escape(i["href"])}">{html.escape(i["name"])}</a></td>'
            f'<td class="n">{i["prompts"]}</td><td>{i["first"]}</td><td>{i["last"]}</td><td><small>{i["session"][:8]}</small></td></tr>'
            for i in sorted(infos, key=lambda i: i['last'], reverse=True))
        parts.append(f'<h2>{html.escape(project)}</h2><table><tr><th>session</th><th class="n">prompts</th>'
            f'<th>first prompt</th><th>last prompt</th><th>id</th></tr>{rows}</table>')
    n = sum(len(v) for v in by_project.values())
    js = ("function flt(){const q=document.getElementById('q').value.toLowerCase();document.querySelectorAll('tr[data-s]')"
        ".forEach(r=>r.classList.toggle('hidden',q&&!r.innerText.toLowerCase().includes(q)));}")
    out = OUT_ROOT / 'index.html'
    out.write_text(f'<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>Claude Code sessions</title>'
        f'<style>{INDEX_CSS}</style></head><body>{header}<div class="meta">{plural(n, "rendered session")} in '
        f'{plural(len(by_project), "project")} · run claude-conversation (--all) in a project to add or refresh its sessions</div>'
        f'<input id="q" placeholder="filter sessions" oninput="flt()">' + '\n'.join(parts) + f'<script>{js}</script></body></html>')
    return out, n, len(by_project)


class QuietHandler(http.server.SimpleHTTPRequestHandler):
    server_version = 'claude-conversation'   # lets server_status() recognize its own server

    def log_message(self, *args):
        pass


def run_server(port: int) -> None:
    """Serves OUT_ROOT on all interfaces until killed (the process that --serve starts)."""
    handler = functools.partial(QuietHandler, directory=str(OUT_ROOT))
    http.server.ThreadingHTTPServer(('', port), handler).serve_forever()


def server_status(port: int) -> str:
    """'ours' (this script's server answers on port), 'other' (something else does) or 'none'."""
    try:
        conn = http.client.HTTPConnection('127.0.0.1', port, timeout=2)
        conn.request('HEAD', '/')
        server = conn.getresponse().getheader('Server') or ''
    except OSError:
        return 'none'
    except http.client.HTTPException:
        return 'other'
    return 'ours' if server.startswith(QuietHandler.server_version) else 'other'


def server_files(port: int):
    """(pid file, log file) of the server on port."""
    return (Path.home() / '.claude' / f'conversation-server-{port}.pid',
        Path.home() / '.claude' / f'conversation-server-{port}.log')


def ensure_server(port: int) -> str:
    """Starts the background server on port unless it is running. Returns 'started' or 'running'."""
    status = server_status(port)
    if status == 'ours':
        return 'running'
    if status == 'other':
        sys.exit(f'port {port} is in use by another program (pick another with --port)')
    pidfile, logfile = server_files(port)
    OUT_ROOT.mkdir(parents=True, exist_ok=True)
    # own session and no inherited stdio, so it outlives this process and does not hold open the
    # pipe of whatever ran it (e.g. Claude Code's `!`, which would otherwise wait for it)
    with logfile.open('w') as log:
        proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), '--_server', str(port)],
            stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    for _ in range(50):
        if server_status(port) == 'ours':
            pidfile.write_text(f'{proc.pid}\n')
            return 'started'
        if proc.poll() is not None:
            break
        time.sleep(0.1)
    sys.exit(f'could not start the server on port {port} (see {logfile})')


def server_pid(port: int) -> int | None:
    """pid of the server on port, from its pid file (None if missing or not this script's server)."""
    pidfile, _ = server_files(port)
    try:
        pid = int(pidfile.read_text())
        if b'--_server' in Path(f'/proc/{pid}/cmdline').read_bytes():
            return pid
    except (OSError, ValueError):
        pass
    return None


def stop_server(port: int) -> str:
    pid = server_pid(port)
    if pid is None:
        if server_status(port) == 'ours':
            return f'server on port {port} has no valid pid file ({server_files(port)[0]}): kill it by hand'
        return f'no server running on port {port}'
    os.kill(pid, signal.SIGTERM)
    for _ in range(30):
        if server_status(port) != 'ours':
            server_files(port)[0].unlink()
            return f'stopped server on port {port} (pid {pid})'
        time.sleep(0.1)
    return f'sent SIGTERM to the server on port {port} (pid {pid}), but it is still answering'


def stop_command(port: int) -> str:
    return 'claude-conversation --stop-server' + ('' if port == SERVER_PORT else f' --port {port}')


def at_exit_with_server(port: int, started: bool, watch: bool) -> None:
    """atexit hook of --serve runs. When a --watch run in a terminal ends, asks whether to stop the
    server: anything but no stops it, including another Ctrl+C. Says how to stop it whenever a --watch
    run leaves it running, or when a run in a terminal has just started it.
    """
    if server_status(port) != 'ours':
        return
    pid = server_pid(port)
    running = f'the server on port {port} (pid {pid or "unknown"}) is still running; stop it with: {stop_command(port)}'
    interactive = sys.stdin.isatty() and sys.stderr.isatty()
    if not (watch and interactive):
        if watch:
            print(running, file=sys.stderr)
        elif started and interactive:
            print(f'started the server in the background (pid {pid}); stop it with: {stop_command(port)}', file=sys.stderr)
        return
    how = ''
    print(f'stop the server on port {port} (pid {pid or "unknown"})? [Y/n] ', end='', file=sys.stderr, flush=True)
    try:
        answer = input()
    except KeyboardInterrupt:
        answer, how = '', 'Ctrl+C at the prompt: '
        print(file=sys.stderr)
    except EOFError:
        answer = ''
        print(file=sys.stderr)
    signal.signal(signal.SIGINT, signal.SIG_IGN)   # answered: let the rest finish
    if answer.strip().lower() not in ('n', 'no'):
        print(how + stop_server(port), file=sys.stderr)
    # whatever happened above (left running, or stopping it failed), say how to stop it if it is up
    if server_status(port) == 'ours':
        print(running, file=sys.stderr)


def server_base(port: int) -> str:
    """http:// URL of OUT_ROOT, at the address SSH reached this machine on (else localhost)."""
    ssh = os.environ.get('SSH_CONNECTION', '').split()
    host = ssh[2] if len(ssh) == 4 else 'localhost'
    return f'http://{f"[{host}]" if ":" in host else host}:{port}'


def server_description(port: int) -> str:
    """Where the server on port is and its pid, for the pages' title line."""
    pid = server_pid(port)
    return (f'served from {server_base(port).removeprefix("http://")} on {socket.gethostname()} · '
        f'server pid {pid if pid else "unknown"}')


def url_for(path: Path, base: str | None) -> str:
    """http:// URL of path under the server at base when served (it is within OUT_ROOT), else file://."""
    path = path.resolve()
    if base and path.is_relative_to(OUT_ROOT.resolve()):
        rel = path.relative_to(OUT_ROOT.resolve()).as_posix()
        return f'{base}/' + ('' if rel == 'index.html' else urllib.parse.quote(rel))
    return path.as_uri()


def plural(n: int, word: str) -> str:
    return f'{n} {word}{"" if n == 1 else "s"}'


def find_sessions(project_dir: Path):
    return sorted(project_dir.glob('*.jsonl'), key=lambda p: p.stat().st_mtime, reverse=True)


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    ap.add_argument('--project', type=Path, default=Path.cwd(), help='project directory (default: cwd)')
    ap.add_argument('--session', help='session id (prefix) in that project')
    ap.add_argument('--jsonl', type=Path, help='explicit transcript file')
    ap.add_argument('--all', action='store_true', help='render every session of the project')
    ap.add_argument('--out', type=Path, help='output HTML path (single session)')
    ap.add_argument('--open', action='store_true', help='open the page in the browser (xdg-open)')
    ap.add_argument('--auto-refresh', type=int, metavar='SEC',
        help='page reloads itself every SEC seconds, to show regenerations by other runs (e.g. you re-running '
        'the command, or a Claude Code Stop hook); 0 removes that from a page')
    ap.add_argument('--watch', type=int, default=0, metavar='SEC', help='regenerate every SEC seconds (implies --auto-refresh SEC)')
    ap.add_argument('--serve', action='store_true',
        help='start a background HTTP server for the pages (unless running) and print http:// URLs')
    ap.add_argument('--port', type=int, default=SERVER_PORT, help=f'port for --serve (default: {SERVER_PORT})')
    ap.add_argument('--stop-server', action='store_true', help='stop the --serve server on --port and exit')
    ap.add_argument('--_server', type=int, help=argparse.SUPPRESS)
    ap.add_argument('-v', '--verbose', action='store_true',
        help='print each page path with its session name and prompt count, then the index URL '
        '(default: only one URL, of the page or, for several sessions, of the index)')
    args = ap.parse_args()
    if args._server:
        return run_server(args._server)
    if args.stop_server:
        return print(stop_server(args.port))
    slug = project_slug(args.project.resolve())
    pdir = PROJECTS / slug
    if args.jsonl:
        files = [args.jsonl]
    else:
        if not pdir.exists():
            sys.exit(f'no transcripts for {args.project} (expected {pdir})')
        files = find_sessions(pdir)
        if args.session:
            files = [f for f in files if f.stem.startswith(args.session)]
        if not args.all:
            files = files[:1]
        if not files:
            sys.exit('no matching session')
    outs = [args.out if (args.out and len(files) == 1) else OUT_ROOT / slug / f'{f.stem}.html' for f in files]
    # open tabs of a page generated with --auto-refresh would silently stop reloading if a run without
    # it regenerated the page, so such runs are refused (--watch reloads them itself)
    previous = [(session_info(out) or {}).get('auto_refresh', 0) for out in outs]
    if args.auto_refresh is None and not args.watch and any(previous):
        stale = [(sec, out) for sec, out in zip(previous, outs) if sec]
        sec, out = stale[0]
        others = f' (and {plural(len(stale) - 1, "other page")})' if len(stale) > 1 else ''
        sys.exit(f'{out}{others} was generated with --auto-refresh {sec}: pass --auto-refresh {sec} again to '
            'keep it reloading itself in open tabs, or --auto-refresh 0 to turn that off')
    keep_refresh = [sec if args.auto_refresh is None else args.auto_refresh for sec in previous]
    refresh = args.watch or args.auto_refresh or 0
    base = server = None
    if args.serve:
        status = ensure_server(args.port)
        atexit.register(at_exit_with_server, args.port, started=status == 'started', watch=bool(args.watch))
        base = server_base(args.port)
        server = server_description(args.port)
        if args.verbose:
            print(f'server {"started" if status == "started" else "already running"}: {base}/', flush=True)
    first_pass = True
    try:
        while True:
            for f, out, keep in zip(files, outs, keep_refresh):
                turns, name = build_turns(f)
                prompts = [t for t in turns if t['kind'] == 'prompt']
                if not name:   # untitled: fall back to the start of the first prompt
                    first = prompts[0]['prompt'].split('\n')[0] if prompts else ''
                    name = (first[:60] + '...') if len(first) > 60 else first or '(empty session)'
                out.parent.mkdir(parents=True, exist_ok=True)
                index_href = urllib.parse.quote(Path(os.path.relpath(OUT_ROOT / 'index.html', out.parent.resolve())).as_posix())
                out.write_text(render(turns, name, f, args.project.resolve(), refresh, header_html(server, index_href), keep))
                if args.verbose:
                    print(f'{url_for(out, base) if base else out}  "{name}"  ({plural(len(prompts), "prompt")})', flush=True)
            index, n_sessions, n_projects = write_index(header_html(server))
            if args.verbose:
                print(f'index of all rendered sessions: {url_for(index, base)}  ({plural(n_sessions, "session")} in {plural(n_projects, "project")})', flush=True)
            elif first_pass:   # the URLs do not change between --watch passes
                print(url_for(outs[0] if len(outs) == 1 else index, base), flush=True)
            first_pass = False
            if args.open:
                for out in outs:
                    subprocess.Popen(['xdg-open', url_for(out, base)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                args.open = False
            if not args.watch:
                break
            time.sleep(args.watch)
    except KeyboardInterrupt:   # the way --watch ends: no traceback (and --serve's atexit hook runs)
        print(file=sys.stderr)
        sys.exit(130)


if __name__ == '__main__':
    main()
